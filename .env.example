# The Noun Project API Credentials
# Get them from: https://thenounproject.com/developers/apps/

NOUN_CONSUMER_KEY=your_consumer_key_here
NOUN_CONSUMER_SECRET=your_consumer_secret_here

# API Tier Configuration
# FREE: trial quotas — 2,000 service calls/month (1,000/day) and 150 icon calls/month (and 150/day)
# PAID: Pay-Per-Use or custom — still hourly/daily/monthly service vs icon windows
# Default: FREE
NOUN_API_TIER=FREE
