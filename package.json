{
  "name": "@alisaitteke/noun-mcp",
  "version": "1.0.4",
  "description": "Production MCP server for The Noun Project — search & download icons in Cursor/Claude with OAuth 1.0a, rate limiting, and FREE-tier cost optimization",
  "repository": {
    "type": "git",
    "url": "https://github.com/alisaitteke/noun-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/alisaitteke/noun-mcp/issues"
  },
  "homepage": "https://github.com/alisaitteke/noun-mcp#readme",
  "author": "Ali Sait Teke <alisaitteke@gmail.com> (https://github.com/alisaitteke)",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "noun-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "docs/icons",
    "docs/hero.png",
    "docs/ARCHITECTURE.md",
    "docs/SOCIAL.md",
    "docs/og-github.png",
    "docs/og-linkedin.png",
    "scripts/prepare.mjs"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node scripts/clean-dist.mjs && tsc && chmod +x dist/index.js",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "generate:og": "node scripts/generate-og-assets.mjs",
    "test": "tsx --test src/api/requestLayer.test.ts",
    "prepare": "node scripts/prepare.mjs",
    "sync:server-version": "tsx scripts/sync-server-version.ts",
    "verify:pack": "node scripts/verify-pack.mjs",
    "prepublishOnly": "npm run build && npm run sync:server-version && npm run verify:pack"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "noun-project",
    "icons",
    "icon-search",
    "icon-download",
    "cursor",
    "cursor-ai",
    "claude",
    "claude-desktop",
    "ai",
    "ai-tools",
    "svg",
    "png",
    "design",
    "developer-tools",
    "typescript",
    "oauth",
    "open-source",
    "software-architect",
    "developer-experience",
    "api-integration"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "mcpName": "io.github.alisaitteke/noun-mcp",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.25.3",
    "axios": "^1.13.5",
    "bottleneck": "^2.19.5",
    "crypto-js": "^4.2.0",
    "dotenv": "^16.4.5",
    "lru-cache": "^10.4.3",
    "oauth-1.0a": "^2.2.6",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  },
  "overrides": {
    "@hono/node-server": "^1.19.10",
    "hono": "^4.12.4"
  }
}
